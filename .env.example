# Copy to .env and change for anything other than local development.
POSTGRES_USER=mimre
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mimre
# Password for the app's restricted database role (created by the migrations).
APP_DB_PASSWORD=change-me-too

# Host port for the full Docker stack (web + api behind nginx).
WEB_PORT=8338

# Email for login codes. Defaults to the local Mailpit container; set real SMTP in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# MAIL_FROM=Mimre <mimre@example.com>
